# Tavily Search API Configuration
TAVILY_API_KEY=your_tavily_api_key_here

# LLM Model Selection: 'ollama' or 'gemini'
LLM_MODEL_TYPE=gemini

# Ollama Configuration (if LLM_MODEL_TYPE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # Options: mistral, llama2, neural-chat

# Google Gemini Configuration (if LLM_MODEL_TYPE=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Contact Finder Configuration
SEARCH_DELAY_SECONDS=2  # Delay between searches to respect rate limits
MAX_RETRY_ATTEMPTS=3    # Number of retry attempts per company
BATCH_SIZE=10           # Companies to process in parallel batches
